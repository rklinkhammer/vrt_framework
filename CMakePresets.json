{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
  "configurePresets": [
    {"name": "dev", "generator": "Ninja", "binaryDir": "${sourceDir}/build/dev", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON", "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"}},
    {"name": "asan-ubsan", "inherits": "dev", "binaryDir": "${sourceDir}/build/asan-ubsan", "cacheVariables": {"VITA_SANITIZER": "address-undefined"}},
    {"name": "tsan", "inherits": "dev", "binaryDir": "${sourceDir}/build/tsan", "cacheVariables": {"VITA_SANITIZER": "thread"}}
  ],
  "buildPresets": [
    {"name": "dev", "configurePreset": "dev"},
    {"name": "asan-ubsan", "configurePreset": "asan-ubsan"},
    {"name": "tsan", "configurePreset": "tsan"}
  ],
  "testPresets": [
    {"name": "dev", "configurePreset": "dev", "output": {"outputOnFailure": true}},
    {"name": "asan-ubsan", "configurePreset": "asan-ubsan", "output": {"outputOnFailure": true}},
    {"name": "tsan", "configurePreset": "tsan", "output": {"outputOnFailure": true}}
  ]
}
